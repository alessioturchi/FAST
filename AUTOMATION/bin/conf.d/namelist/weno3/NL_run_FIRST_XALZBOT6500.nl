#&NAM_LUNITn and &NAM_FMOUT are automatically generated by function prep_list_run()
#ALL variables *_VAR are sobsituted by the function with parameters in run.var
#CINIFILE_FILE CINIFILEPGD_FILE CCPLFILE_LINE XFMOUT_LINE XTSTEP_VAR CCLOUD_VAR CEXP_VAR CSEG_VAR XSEGLEN_VAR NDAD_LINE NDTRATIO_LINE XWAY_LINE XSNG*_VAR DOM_FIRST, DOM_SECOND, SUPCOMP_VAR, MESODIAG_VAR, NMODEL_VAR /

#Comments are filtered out as well, so feel free to add coments here
&NAM_LUNITn CINIFILE ='CINIFILE_FILE',CINIFILEPGD='CINIFILEPGD_FILE'
CCPLFILE_LINE /
&NAM_FMOUT XFMOUT_LINE /

&NAM_CONFn LUSERV=T, NSV_USER=0 /
&NAM_DYNn XTSTEP=XTSTEP_VAR, CPRESOPT='CPRESOPT_VALUE', LITRADJ=T,
          XRELAX=1, LHORELAX_UVWTH=T, LHORELAX_RV=T,
          LHORELAX_RC=F, LHORELAX_RR=F, LHORELAX_RI=F,
          LHORELAX_RS=F, LHORELAX_RG=F, LHORELAX_RH=F,
          LHORELAX_TKE=F, NRIMX=6,NRIMY=6, XRIMKMAX=0.0003333 /
&NAM_CONFZ MPI_BUFFER_SIZE=400 /
&NAM_ADVn CUVW_ADV_SCHEME="WENO_K", NWENO_ORDER=3, CTEMP_SCHEME='RK21', CMET_ADV_SCHEME='PPM_01' /
&NAM_PARAMn  CTURB='TKEL', CRAD='ECMWF', CCLOUD='CCLOUD_VAR',
             CDCONV='NONE'  /
&NAM_PARAM_KAFRn XDTCONV=300. /
&NAM_PARAM_RADn XDTRAD = 1800., XDTRAD_CLONLY = 1800., LCLEAR_SKY = F/
&NAM_SEAFLUXn CSEA_FLUX='DIRECT', CSEA_ALB='UNIF' /
&NAM_ISBAn CSNOWRES='DEF', CALBEDO='EVOL' /
&NAM_SSOn CROUGH='Z04D' /
&NAM_LBCn CLBCX=2*'OPEN', CLBCY=2*'OPEN' /
&NAM_TURBn XIMPL=1, CTURBLEN='BL89', CTURBDIM='1DIM',
           LTURB_FLX=F, LTURB_DIAG=F, LSUBG_COND=F,
           CSUBG_AUCV='NONE', LSIGMAS=F, LSIG_CONV=F, LRMC01=T, XKEMIN=0.0001 /
&NAM_CH_MNHCn /
&NAM_SERIESn /
&NAM_CH_SOLVERn /
&NAM_CONF CSPLIT='BSPLITTING', CCONF='START', CEQNSYS ='LHE', LFLAT=F,
          LFORCING=F, NMODEL=NMODEL_VAR, NVERB=10, LLG=F,
          LINIT_LG=F, LNOMIXLG=F, CEXP='CEXP_VAR', CSEG='CSEG_VAR', NHALO=1 /
&NAM_DYN XSEGLEN=XSEGLEN_VAR, XASSELIN=0.2, LCORIO=T, LNUMDIFU=F,
          XALKTOP=0.001, XALZBOT=6500 /
&NAM_NESTING NDAD_LINE
             NDTRATIO_LINE
             XWAY_LINE  /
&NAM_TURB XPHI_LIM=3., XSBL_O_BL=0.05, XFTOP_O_FSURF=0.05 /
&NAM_BUDGET /
&NAM_BU_RU /
&NAM_BU_RV /
&NAM_BU_RW /
&NAM_BU_RTH /
&NAM_BU_RTKE /
&NAM_BU_RRV /
&NAM_BU_RRC /
&NAM_BU_RRR /
&NAM_BU_RRI /
&NAM_BU_RRS /
&NAM_BU_RRG /
&NAM_BU_RRH /
&NAM_BU_RSV /
&NAM_LES /
&NAM_BLANK  NDUMMY1=XSNG1_VAR, NDUMMY2=YSNG1_VAR,
            NDUMMY3=XSNG2_VAR, NDUMMY4=YSNG2_VAR,
            NDUMMY5=SEESTPOINT_VAR, 
            NDUMMY7=DOM_FIRST, NDUMMY8=DOM_SECOND, LDUMMY1=SUPCOMP_VAR, LDUMMY8=MESODIAG_VAR /
&NAM_FRC /
&NAM_PARAM_ICE /
&NAM_PARAM_C2R2 /
&NAM_SERIES /
&NAM_TURB_CLOUD /
&NAM_CONFIO LCDF4=F /
