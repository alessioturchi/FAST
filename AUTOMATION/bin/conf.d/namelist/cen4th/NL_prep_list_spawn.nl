&NAM_GRID2_SPA /
&NAM_LUNIT2_SPA CINIFILE='CINIFILE_VALUE', CINIFILEPGD='CINIFILEPGD_FILE',
                YSPAFILE='CINIFILE_VALUE.spa',
                YDOMAIN='YDOMAIN_VALUE' /
&NAM_SPAWN_SURF LSPAWN_SURF=T /
&NAM_CONFIO LCDF4=F /
&NAM_CONF_SPAWN NHALO=1 /
