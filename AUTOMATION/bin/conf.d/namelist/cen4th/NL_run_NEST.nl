#&NAM_LUNITn is automatically generated by function prep_list_run()
#ALL variables *_VAR are sobsituted by the function with parameters in run.var
#XRIMKMAX_VAR CCLOUD_VAR
#Comments are filtered out as well, so feel free to add coments here
&NAM_LUNITn CINIFILE ='CINIFILE_FILE',CINIFILEPGD='CINIFILEPGD_FILE'
/
&NAM_CONFn LUSERV=T, NSV_USER=0 /
&NAM_DYNn CPRESOPT='CPRESOPT_VALUE', LITRADJ=T,
          XRELAX=1, LHORELAX_UVWTH=F, LHORELAX_RV=F,
          LHORELAX_RC=F, LHORELAX_RR=F, LHORELAX_RI=F,
          LHORELAX_RS=F, LHORELAX_RG=F, LHORELAX_RH=F,
          LHORELAX_TKE=F, LVE_RELAX=T,
          NRIMX=6,NRIMY=6, XRIMKMAX=XRIMKMAX_VAR /
&NAM_ADVn CUVW_ADV_SCHEME="CEN4TH", CTEMP_SCHEME='RK21', CMET_ADV_SCHEME='PPM_01' /
&NAM_PARAMn  CTURB='TKEL', CRAD='ECMWF', CCLOUD='CCLOUD_VAR',
             CDCONV='NONE'  /
&NAM_PARAM_KAFRn XDTCONV=300. /
&NAM_PARAM_RADn XDTRAD = 1800., XDTRAD_CLONLY = 1800., LCLEAR_SKY = F/
&NAM_SEAFLUXn CSEA_FLUX='DIRECT', CSEA_ALB='UNIF' /
&NAM_ISBAn CSNOWRES='DEF', CALBEDO='EVOL' /
&NAM_SSOn CROUGH='Z04D' /
&NAM_LBCn CLBCX=2*'OPEN', CLBCY=2*'OPEN'/
&NAM_TURBn XIMPL=1, CTURBLEN='BL89', CTURBDIM='1DIM',
           LTURB_FLX=F, LTURB_DIAG=F, LSUBG_COND=F,
           CSUBG_AUCV='NONE', LSIGMAS=F, LSIG_CONV=F, LRMC01=T, XKEMIN=0.0001 /
&NAM_CH_MNHCn /
&NAM_SERIESn /
&NAM_CH_SOLVERn /
&NAM_CONF NHALO=1 /
