#CPGDFILE_VALUE, YINIFILE_VALUE, IXOR_PREC, IYOR_PREC, IXSIZE_VALUE, IYSIZE_VALUE, IDXRATIO_VALUE, IDYRATIO_VALUE, YCOVER_FILE, YZS_FILE, YFILETYPE_VALUE, YCLAY_FILE, and YSAND_FILE are automatically generated by function prep_list_pgd()
#ABOVE variables are sobsituted by the function with parameters in defined in config files
#Comments are filtered out as well, so feel free to add coments here
&NAM_PGDFILE CPGDFILE="CPGDFILE_VALUE" /
&NAM_PGD_GRID   YINIFILE="YINIFILE_VALUE", YFILETYPE='MESONH' /
&NAM_INIFILE_CONF_PROJ IXOR=IXOR_PREC, IYOR=IYOR_PREC, IXSIZE=IXSIZE_VALUE, IYSIZE=IYSIZE_VALUE, IDXRATIO=IDXRATIO_VALUE, IDYRATIO=IDYRATIO_VALUE /
&NAM_COVER     YCOVER="YCOVER_FILE", YFILETYPE='DIRECT' /
&NAM_ZS        YZS="YZS_FILE",    YFILETYPE="YFILETYPE_VALUE" /
&NAM_ISBA      YCLAY="YCLAY_FILE", YCLAYFILETYPE='DIRECT',
               YSAND="YSAND_FILE", YSANDFILETYPE='DIRECT' /
&NAM_SEABATHY XUNIF_SEABATHY=0 /
&NAM_CONFIO LCDF4=F /
&NAM_CONF_PGD NHALO_MNH=1 /
