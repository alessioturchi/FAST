#CPGDFILE_VALUE, XLATCEN_VALUE, XLONCEN_VALUE, XRPK_VALUE, NIMAX_VALUE, NJMAX_VALUE, XDX_VALUE, XDY_VALUE, YCOVER_FILE, YZS_FILE, YFILETYPE_VALUE, YCLAY_FILE and YSAND_FILE  are automatically generated by function prep_list_pgd()
#ABOVE variables are sobsituted by the function with parameters in defined in config files
#Comments are filtered out as well, so feel free to add coments here
&NAM_PGDFILE CPGDFILE="CPGDFILE_VALUE" /
&NAM_CONF_PROJ
 XLAT0=XLATCEN_VALUE, XLON0=XLONCEN_VALUE, XRPK=XRPK_VALUE, XBETA=0. /
&NAM_CONF_PROJ_GRID
 XLATCEN=XLATCEN_VALUE, XLONCEN=XLONCEN_VALUE,
 NIMAX=NIMAX_VALUE, NJMAX=NJMAX_VALUE,
 XDX=XDX_VALUE., XDY=XDY_VALUE. /
&NAM_COVER     YCOVER="YCOVER_FILE", YFILETYPE='DIRECT' /
&NAM_ZS        YZS="YZS_FILE",    YFILETYPE="YFILETYPE_VALUE" /
&NAM_ISBA      YCLAY="YCLAY_FILE", YCLAYFILETYPE='DIRECT',
               YSAND="YSAND_FILE", YSANDFILETYPE='DIRECT' /
&NAM_SEABATHY XUNIF_SEABATHY=0 /
&NAM_CONFIO LCDF4=F /
&NAM_CONF_PGD NHALO_MNH=1 /
