#HATMFILE_VALUE, HPGDFILE_VALUE CINIFILE_FILE and CFILEPGD_FILE are automatically generated by function prep_list_real()
#ABOVE variables are sobsituted by the function with parameters in defined in config files
#Comments are filtered out as well, so feel free to add coments here
&NAM_FILE_NAMES HATMFILE="HATMFILE_VALUE.spa", HATMFILETYPE='MESONH',
             HPGDFILE="HPGDFILE_VALUE",
             CINIFILE="CINIFILE_FILE" /
&NAM_REAL_CONF CEQNSYS='LHE', CPRESOPT="CPRESOPT_VALUE", NVERB=10, NHALO=1 /
&NAM_VER_GRID YZGRID_TYPE='SAMEGR' /
&NAM_PREP_SURF_ATM CFILE="HATMFILE_VALUE", CFILETYPE='MESONH', CFILEPGD="CFILEPGD_FILE" /
&NAM_CONFIO LCDF4=F /
