#YINIFILE_VALUE, XALT_OT2D_INF_VALUE, XALT_OT2D_SUP_VALUE and YSUFFIX_VALUE are automatically generated by function prep_list_diag()
#ABOVE variables are sobsituted by the function with parameters in defined in config files
#Comments are filtered out as well, so feel free to add coments here
&NAM_DIAG
 CISO='PREVTK',
 LVAR_RS=T,
 NRAD_3D=0,
 LVAR_TURB=T,
#Useful only for research:
 LTURBDIAG=T,
# LTURBFLX=T,
 LTPZH=T,
 LMSLP=T,
# LBV_FR=T
/
&NAM_DIAG_BLANK 
 LDUMMY_DIAG(10)=T, LDUMMY_DIAG(11)=T, XDUMMY_DIAG(:)=0. /
&NAM_DIAG_FILE  YINIFILE(1) = "YINIFILE_VALUE" ,
                YINIFILEPGD(1) = "PGD_FILE" ,
                YSUFFIX = "YSUFFIX_VALUE" /
&NAM_DIAG_TURBOPT XALT_OT2D_INF=XALT_OT2D_INF_VALUE, XALT_OT2D_SUP=XALT_OT2D_SUP_VALUE,CTO_SCHEMA="ST", CTO_TYPE="OPT",
                  XLAMBDA=0.5E-6 /
&NAM_DIAG_SURFn N2M=2, LSURF_BUDGET=T /
&NAM_CONFIO LCDF4=F /
&NAM_CONF_DIAG NHALO=1 /
