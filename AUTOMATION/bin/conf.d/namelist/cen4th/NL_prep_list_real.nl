#HATMFILE_VALUE, HPGDFILE_VALUE and CINIFILE_FILE are automatically generated by function prep_list_real()
#NKMAX_VALUE ZDZGRD_VALUE ZDZTOP_VALUE ZZMAX_STRGRD_VALUE ZSTRGRD_VALUE ZSTRTOP_VALUE
#ABOVE variables are sobsituted by the function with parameters in defined in config files
#Comments are filtered out as well, so feel free to add coments here
&NAM_FILE_NAMES HATMFILE='HATMFILE_VALUE', HATMFILETYPE='GRIBEX',
             HPGDFILE='HPGDFILE_VALUE',
             CINIFILE='CINIFILE_FILE' /
&NAM_REAL_CONF CEQNSYS='LHE', CPRESOPT='CPRESOPT_VALUE', NVERB=10, NHALO=1 /
&NAM_VER_GRID NKMAX=NKMAX_VALUE, YZGRID_TYPE='FUNCTN', ZDZGRD=ZDZGRD_VALUE, ZDZTOP=ZDZTOP_VALUE,
              ZZMAX_STRGRD=ZZMAX_STRGRD_VALUE, ZSTRGRD=ZSTRGRD_VALUE, ZSTRTOP=ZSTRTOP_VALUE /
&NAM_CONFIO LCDF4=F /
